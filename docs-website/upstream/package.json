{
  "name": "solid-aria-docs-website",
  "private": true,
  "scripts": {
    "check:docs": "node --conditions=react-server preflight.mjs",
    "predev": "node generate-native-registry.mjs",
    "prebuild": "node generate-native-registry.mjs",
    "dev:button": "cd packages/dev/s2-docs && DOCS_ISLAND_SCOPE=Button DOCS_ENV=dev LIBRARY=react-aria parcel pages/react-aria/Button.mdx -p 4340 --target react-static --config .parcelrc-s2-docs --dist-dir ../../../../dist-button --cache-dir ../../../../.parcel-cache-button",
    "dev:slice": "cd packages/dev/s2-docs && DOCS_ISLAND_SCOPE=Slider DOCS_ENV=dev LIBRARY=react-aria parcel pages/react-aria/Slider.mdx -p 4340 --target react-static --config .parcelrc-s2-docs --dist-dir ../../../../dist-slice --cache-dir ../../../../.parcel-cache-slice",
    "dev": "cd packages/dev/s2-docs && NODE_OPTIONS=--max-old-space-size=8192 DOCS_ENV=dev LIBRARY=react-aria parcel 'pages/react-aria/*.mdx' -p 4340 --no-hmr --target react-static --config .parcelrc-s2-docs --dist-dir ../../../../dist --cache-dir ../../../../.parcel-cache",
    "build": "cd packages/dev/s2-docs && NODE_OPTIONS=--max-old-space-size=8192 DOCS_ENV=dev LIBRARY=react-aria parcel build 'pages/react-aria/*.mdx' --target react-static --config .parcelrc-s2-docs --dist-dir ../../../../dist-build --cache-dir ../../../../.parcel-cache-build"
  },
  "dependencies": {
    "@babel/parser": "^7.26.3",
    "@parcel/plugin": "^2.16.3",
    "@parcel/rsc": "2.16.3",
    "@react-aria/focus": "^3.20.4",
    "@react-aria/i18n": "^3.12.10",
    "@react-aria/interactions": "^3.25.1",
    "@react-aria/utils": "^3.29.0",
    "@react-spectrum/ai": "file:packages/@react-spectrum/ai",
    "@react-spectrum/s2": "file:packages/@react-spectrum/s2",
    "@react-spectrum/utils": "^3.12.6",
    "@react-types/shared": "^3.30.0",
    "emojibase": "^17.0.0",
    "emojibase-data": "^17.0.0",
    "fast-glob": "^3.3.3",
    "globals-docs": "^2.4.1",
    "gray-matter": "^4.0.3",
    "json5": "^2.2.3",
    "lz-string": "^1.5.0",
    "markdown-to-jsx": "^6.11.0",
    "mdast-util-mdx": "^1.0.0",
    "mdast-util-to-markdown": "^1.0.0",
    "react": "19.3.0",
    "react-aria": "^3.40.0",
    "react-aria-components": "^1.7.1",
    "react-dom": "19.3.0",
    "react-server-dom-parcel": "19.3.0",
    "react-stately": "^3.38.0",
    "remark-mdx": "^3.1.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "rsc-html-stream": "^0.0.8",
    "satori": "^0.16.1",
    "sharp": "^0.33.5",
    "textarea-caret": "^3.1.0",
    "tree-sitter-highlight": "^1.0.1",
    "ts-morph": "^26.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "parcel": "^2.16.3",
    "@parcel/config-default": "^2.16.3",
    "@parcel/resolver-glob": "^2.16.3",
    "@parcel/transformer-inline": "^2.16.3",
    "@parcel/transformer-inline-string": "^2.16.3",
    "@parcel/transformer-svg-react": "^2.16.3",
    "@parcel/packager-react-static": "^2.16.3",
    "@parcel/transformer-react-static": "^2.16.3",
    "@parcel/optimizer-terser": "^2.16.3",
    "@parcel/rust": "^2.16.3",
    "@tailwindcss/postcss": "^4.0.17",
    "postcss": "^8.4.24",
    "tailwindcss": "^4.0.0",
    "@adobe/spectrum-tokens": "14.15.0",
    "clsx": "^2.0.0",
    "color-space": "^1.16.0",
    "delta-e": "^0.0.8",
    "tailwind-variants": "0.3.1",
    "tw-animate-css": "^1.4.0",
    "tailwindcss-react-aria-components": "^2.0.1",
    "lucide-react": "^0.517.0",
    "process": "0.11.10",
    "solid-js": "2.0.0-rc.20",
    "@solidjs/web": "2.0.0-rc.20",
    "@solidjs/babel-plugin": "2.0.0-rc.20",
    "@solidjs/signals": "2.0.0-rc.20",
    "@solidjs/compiler": "2.0.0-rc.20",
    "@babel/core": "7.29.7",
    "@react-spectrum/docs": "file:packages/dev/docs",
    "@react-aria/optimize-locales-plugin": "file:packages/dev/optimize-locales-plugin",
    "parcel-namer-docs": "file:packages/dev/parcel-namer-docs",
    "parcel-optimizer-strict-mode": "file:packages/dev/parcel-optimizer-strict-mode",
    "parcel-packager-docs": "file:packages/dev/parcel-packager-docs",
    "parcel-packager-ssg": "file:packages/dev/parcel-packager-ssg",
    "parcel-resolver-build": "file:packages/dev/parcel-resolver-build",
    "parcel-resolver-docs": "file:packages/dev/parcel-resolver-docs",
    "@react-aria/parcel-resolver-optimize-locales": "file:packages/dev/parcel-resolver-optimize-locales",
    "parcel-transformer-css-env": "file:packages/dev/parcel-transformer-css-env",
    "parcel-transformer-docs": "file:packages/dev/parcel-transformer-docs",
    "parcel-transformer-intl": "file:packages/dev/parcel-transformer-intl",
    "parcel-transformer-mdx-docs": "file:packages/dev/parcel-transformer-mdx-docs",
    "parcel-transformer-mdx-extract": "file:packages/dev/parcel-transformer-mdx-extract",
    "@react-spectrum/parcel-transformer-s2-icon": "file:packages/dev/parcel-transformer-s2-icon",
    "@adobe/spectrum-css-temp": "file:packages/@adobe/spectrum-css-temp"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "@parcel/transformer-css": {
    "cssModules": {
      "global": true,
      "pattern": "[content-hash]_[local]",
      "exclude": [
        "**/*.global.css",
        "packages/@react-aria/example-theme/**",
        "packages/@react-spectrum/style-macro-s1/**",
        "packages/@react-spectrum/tree/**",
        "packages/@react-spectrum/color/src/*.tsx",
        "packages/@adobe/react-spectrum/src/tree/**",
        "packages/@adobe/react-spectrum/src/color/*.tsx",
        "packages/@react-spectrum/s2/**/*.{js,ts,tsx}",
        "packages/@react-spectrum/s2/stories/**",
        "packages/@react-spectrum/ai/**/*.{js,ts,tsx}",
        "packages/@react-spectrum/ai/stories/**",
        ".storybook-s2/**",
        "packages/dev/s2-docs/**",
        "starters/**",
        "packages/react-aria-components/stories/Sheet.css"
      ]
    },
    "drafts": {
      "nesting": true
    },
    "pseudoClasses": {
      "focusVisible": "focus-ring",
      "hover": "is-hovered"
    }
  },
  "overrides": {
    "@mdx-js/react": "2.0.0-rc.2",
    "@mdx-js/mdx": "2.0.0-rc.2"
  }
}
