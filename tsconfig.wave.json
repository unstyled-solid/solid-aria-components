      "@react-types/shared": ["packages/@react-types/shared/src/pilot.d.ts"],
      "@react-stately/flags": ["packages/@react-stately/flags/src/index.ts"],
      "@adobe/react-spectrum/private/*": ["packages/@adobe/react-spectrum/src/*"],
      "@adobe/react-spectrum/*": ["packages/@adobe/react-spectrum/exports/*"],
      "@spectrum-icons/ui/*": ["packages/@spectrum-icons/ui/src/*"],
      "@adobe/react-spectrum-ui/dist/*": ["packages/@adobe/react-spectrum-ui/src/*"],
      "@spectrum-icons/workflow/*": ["packages/@spectrum-icons/workflow/src/*"],
      "@spectrum-icons/illustrations/NoSearchResults": ["packages/@spectrum-icons/illustrations/src/NoSearchResults.tsx"],
