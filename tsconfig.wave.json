  },
  "files": [
    "test/intl.d.ts",
    "pilot.setup.ts",
    "packages/react-aria-components/src/ColorSwatch.tsx",
    "packages/react-aria-components/src/Separator.tsx",
    "packages/react-aria/src/utils/useLoadMoreSentinel.ts",
    "packages/react-aria/src/utils/useDescription.ts",
    "packages/react-aria/src/utils/useUpdateEffect.ts",
    "packages/react-aria/src/i18n/useCollator.ts",
    "packages/react-aria/src/i18n/useFilter.ts",
    "packages/react-aria/src/i18n/useDateFormatter.ts",
    "packages/react-aria/src/i18n/useListFormatter.tsx",
    "packages/react-aria/src/utils/inertValue.ts",
    "packages/dev/test-utils/src/renderOverride.tsx"
