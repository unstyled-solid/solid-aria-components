{
  "extends": "./tsconfig.pilot.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "paths": {
      "react-aria": ["packages/react-aria/exports/index.ts"],
      "react-aria/private/*": ["packages/react-aria/src/*"],
      "react-aria/test/*": ["packages/react-aria/test/*"],
      "react-aria/*": ["packages/react-aria/exports/*"],
      "react-stately": ["packages/react-stately/exports/index.ts"],
      "react-stately/private/*": ["packages/react-stately/src/*"],
