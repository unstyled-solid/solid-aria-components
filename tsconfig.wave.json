      "react-aria-components/test/AriaMenu.test-util": ["packages/react-aria-components/test/AriaMenu.test-util.tsx"],
      "react-aria-components/slots": ["packages/react-aria-components/src/utils.tsx"],
      "react-aria-components/*": ["packages/react-aria-components/exports/*"],
      "@react-spectrum/s2/style": ["packages/@react-spectrum/s2/style/index.ts"],
      "@react-spectrum/s2/icons/ChevronRight": ["packages/@react-spectrum/s2/icons/ChevronRight.tsx"],
      "@react-spectrum/s2/private/*": ["packages/@react-spectrum/s2/src/*"],
      "@react-spectrum/s2/*": ["packages/@react-spectrum/s2/exports/*"],
      "@react-aria/test-utils": ["packages/@react-aria/test-utils/src/user.ts"],
      "@internationalized/number": ["packages/@internationalized/number/src/index.ts"],
      "@internationalized/date": ["packages/@internationalized/date/src/index.ts"],
      "@internationalized/date/tests/*": ["packages/@internationalized/date/tests/*"],
      "@internationalized/string": ["packages/@internationalized/string/src/index.ts"]
      ,"@react-spectrum/test-utils-internal": ["packages/dev/test-utils/src/renderOverride.tsx"]
